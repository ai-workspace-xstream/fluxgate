# K3s In-Cluster Hybrid API Steering Example (Optional Extension for traefik-ingress)
#
# Architectural Boundary:
# 1. `traefik-ingress` (namespace: ingress-prod) remains the sole public K3s Ingress/TLS/Canary
#    entry point and works independently without Fluxgate.
# 2. Fluxgate runs as an independent HelmRelease in `ingress-prod` alongside `traefik-ingress`,
#    acting as a GitOps-driven pluggable hybrid traffic scheduler for dual-form APIs.
# 3. Vault KV ONLY loads sensitive credentials (e.g. `kv/data/prod/serverless/cloudflare` keys
#    `CLOUDFLARE_ACCOUNT_ID` & `CLOUDFLARE_API_TOKEN` for DNS adjustments or sensitive upstream
#    tokens). Proportional traffic weights (`80` / `20`) are strictly non-sensitive GitOps config.

{
    http_port 8080
    grace_period 15s
    metrics 0.0.0.0:9102

    vault {
        addr env(VAULT_ADDR)
        auth token
        sync cloudflare kv/data/prod/serverless/cloudflare 5m
    }
}

accounts.svc.plus accounts-selfhost-prod-v6.svc.plus {
    @health path /healthz
    handle @health {
        respond "ok" 200
    }

    # Long-lived SSE streams always stay on the in-cluster Go service
    @agent_sse path /api/agent-server/v1/users/events
    handle @agent_sse {
        reverse_proxy http://web-saas-xconnect-controller.web-saas-prod.svc.cluster.local:80
    }

    # Dual-form proportional split: CF Worker Free primary (80%) + Go selfhost fallback (20%)
    # Managed purely in GitOps ConfigMap + Fluxgate 5s file-hash ArcSwap hot-reload.
    @xconnect_dual {
        path /api/agent-server/v1/* /api/overlay/v1/* /api/auth/sync/*
    }

    handle @xconnect_dual {
        hybrid_proxy {
            mode weighted_failover
            sticky_key header(Authorization)
            retry_safe_methods GET HEAD OPTIONS

            upstream cf_worker https://xconnect-controller-edge.manbuzhe2008.workers.dev {
                weight 80
                rewrite_host xconnect-controller-edge.manbuzhe2008.workers.dev
                header_up X-Forwarded-By fluxgate-hybrid
                connect_timeout 800ms
                read_timeout 2000ms
                daily_budget 85000
                fallback_on_status 429 501 502 503 504 522 524
                fallback_on_header X-XConnect-Fallback=origin-go
            }

            upstream go_origin http://web-saas-xconnect-controller.web-saas-prod.svc.cluster.local:80 {
                weight 20
                role fallback
                connect_timeout 2000ms
                read_timeout 15000ms
            }
        }
    }
}
